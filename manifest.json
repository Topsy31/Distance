{
  "manifest_version": 3,
  "name": "Distance From Home",
  "version": "0.1.0",
  "description": "Highlight a postcode or address on any page to see driving distance and time from home.",
  "permissions": ["storage"],
  "host_permissions": ["https://maps.googleapis.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Distance From Home"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
